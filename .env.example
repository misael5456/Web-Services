PORT=3000
# Carpeta donde se guardan los archivos
STORAGE_DIR=./storage
# Tamaño máximo por archivo (MB)
MAX_FILE_SIZE_MB=10
# Si se define, todas las peticiones a /api/files requieren el header x-api-key
API_KEY=
# Extensiones permitidas (lista blanca)
ALLOWED_EXTENSIONS=.txt,.md,.json,.csv,.pdf,.png,.jpg,.jpeg,.gif,.zip
# CORS: '*' permite cualquier origen; vacío lo desactiva (el cliente en / no lo necesita)
CORS_ORIGIN=*
